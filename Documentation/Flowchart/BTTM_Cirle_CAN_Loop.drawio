        </mxCell>
        <mxCell id="K2nQBVVUvMcCDA-LFtUe-171" parent="K2nQBVVUvMcCDA-LFtUe-170" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#B20000;overflow=hidden;fillColor=#e51400;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontColor=#ffffff;fillStyle=auto;" value="" vertex="1">
          <mxGeometry height="140" width="71" as="geometry">
