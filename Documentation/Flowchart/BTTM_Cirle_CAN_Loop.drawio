          </mxGeometry>
        </mxCell>
        <mxCell id="K2nQBVVUvMcCDA-LFtUe-178" parent="K2nQBVVUvMcCDA-LFtUe-176" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;" value="&lt;blockquote style=&quot;margin: 0 0 0 40px; border: none; padding: 0px;&quot;&gt;&lt;b&gt;Tires Infrared Sensor&lt;/b&gt;&lt;p data-start=&quot;2042&quot; data-end=&quot;2151&quot; style=&quot;&quot;&gt;Non-contact infrared temperature sensor measuring tires surface temperature in real time and to evaluate tyre warm-up, balance, and load distribution.&lt;/p&gt;&lt;p data-start=&quot;2153&quot; data-end=&quot;2351&quot; style=&quot;&quot;&gt;&lt;b&gt;&amp;nbsp;&lt;/b&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;IR sensing avoids mechanical contact, eliminating wear and thermal conduction errors while allowing fast response to rapid tires temperature changes.&lt;/span&gt;&lt;/p&gt;&lt;/blockquote&gt;&lt;p data-start=&quot;2153&quot; data-end=&quot;2351&quot; style=&quot;&quot;&gt;&lt;/p&gt;&lt;ul style=&quot;&quot;&gt;&lt;ul&gt;&lt;li&gt;Operative Temperatures: Min -40°C Max +800&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;°C&lt;br&gt;&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Field of View: 30&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;°&lt;br&gt;&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Accuracy: 0.2&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;°C at 3m,&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;2&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;°C at 30mm&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="180" width="609" x="71" as="geometry">
            <mxRectangle height="180" width="609" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="K2nQBVVUvMcCDA-LFtUe-179" parent="K2nQBVVUvMcCDA-LFtUe-169" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" value="" vertex="1">
          <mxGeometry height="128" width="680" y="488" as="geometry" />
        </mxCell>
        <mxCell id="K2nQBVVUvMcCDA-LFtUe-180" parent="K2nQBVVUvMcCDA-LFtUe-179" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#B09500;overflow=hidden;fillColor=#e3c800;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontColor=#000000;" value="" vertex="1">
