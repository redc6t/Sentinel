        <mxCell id="K2nQBVVUvMcCDA-LFtUe-181" parent="K2nQBVVUvMcCDA-LFtUe-179" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;" value="&lt;blockquote style=&quot;margin: 0 0 0 40px; border: none; padding: 0px;&quot;&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;120 ohm Can Termination Resistor&lt;/b&gt;&lt;/div&gt;&lt;/blockquote&gt;&lt;blockquote style=&quot;margin: 0 0 0 40px; border: none; padding: 0px;&quot;&gt;&lt;p data-start=&quot;3543&quot; data-end=&quot;3645&quot; style=&quot;text-align: left;&quot;&gt;Junction points where local wheel node CAN branches connect into the main CAN backbone.&lt;/p&gt;&lt;p&gt;&lt;/p&gt;&lt;p data-start=&quot;3647&quot; data-end=&quot;3823&quot;&gt;&lt;/p&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Allows modular installation and removal of wheel assemblies while maintaining a continuous CAN trunk. Simplifies vehicle integration and fault isolation.&lt;/span&gt;&lt;/div&gt;&lt;/blockquote&gt;" vertex="1">
          <mxGeometry height="128" width="609" x="71" as="geometry">
            <mxRectangle height="128" width="609" as="alternateBounds" />
